# Postgres connection string (e.g. from Neon, Supabase, or any Postgres host).
# Required for the API routes and for `pnpm db:push`.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Port for the local Express dev server started by `pnpm dev:api`.
# The Vite dev server proxies /api requests here. Not used in production —
# Vercel runs api/index.ts as a serverless function instead.
API_PORT=8787
