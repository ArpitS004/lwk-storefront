# =============================================================================
# LWK Storefront — environment variables
# =============================================================================
# Copy to .env for local development. In production these are set in
# Vercel: Project → Settings → Environment Variables (Production scope).
#
# Variable names must match EXACTLY, including case. A variable named
# "resend" instead of "RESEND_API_KEY" is invisible to the app and the
# feature silently switches off.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the API refuses to start without these
# -----------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, or any Postgres host).
# Also used by `pnpm db:push` and `pnpm db:seed`.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Signing key for session cookies (JWT) and for the OAuth state token.
# Use a long random string — at least 32 characters. Changing it logs
# every user out immediately.
JWT_SECRET=


# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — optional locally
# -----------------------------------------------------------------------------

# Shared secret the external scheduler (cron-job.org) sends as
# `Authorization: Bearer <value>` when calling POST /api/cart-abandonment/check.
# Without it that endpoint is a publicly callable mass-email trigger, so it
# is mandatory whenever NODE_ENV=production.
CRON_SECRET=


# -----------------------------------------------------------------------------
# GOOGLE SIGN-IN — all three needed, or the feature switches off
# -----------------------------------------------------------------------------

# Public origin of the deployed site, no trailing slash. The OAuth redirect
# URI is derived as `${APP_BASE_URL}/api/auth/google/callback` and must match
# the Authorised redirect URI registered in Google Cloud Console exactly.
APP_BASE_URL=https://lwk-storefront-d4s2.vercel.app

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# EMAIL — two providers, either one works. Leave both unset to disable email.
# -----------------------------------------------------------------------------
#
# OPTION A — GMAIL SMTP (free, reaches anyone, no domain needed)
#
# Google itself sends the mail, so it is properly authenticated and lands in
# real inboxes. This is different from sending "as" a Gmail address through
# an email service, which Gmail and Yahoo have rejected since Feb 2024.
#
# Setup:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an App Password:      myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces are stripped for you)
#
# Limits and caveats:
#   - 500 recipients per day on a free Gmail account
#   - The From address is a personal Gmail, not a brand address
#   - Google discourages bulk marketing from personal accounts
#
# When both providers are configured, Gmail wins — the only reason to set it
# is that Resend cannot yet reach real customers.

GMAIL_USER=
GMAIL_APP_PASSWORD=
# Display name shown beside the address. Gmail forces the address itself to
# the authenticated account, so this is the only part you control.
GMAIL_FROM_NAME=LWK


# OPTION B — RESEND (better long-term, needs a verified domain)
# When RESEND_API_KEY is unset the send functions log a warning and return
# without sending. Nothing throws, so the calling route still reports
# success — check the logs, not the UI, to confirm mail actually went out.

RESEND_API_KEY=

# Must be an address on a domain verified in your Resend account.
# `onboarding@resend.dev` is Resend's shared test sender: it works with no
# setup but ONLY delivers to the email address that owns the Resend account.
# Real customers receive nothing until you verify your own domain at
# resend.com/domains.
RESEND_FROM_EMAIL=LWK <onboarding@resend.dev>


# -----------------------------------------------------------------------------
# AI (DeepSeek) — leave unset to run with static fallback copy
# -----------------------------------------------------------------------------
# Used for the abandoned-cart nudge body and the admin segment insights.
# Every call has a 6s timeout and always falls back to plain copy, so an
# unset or failing key degrades quality but never breaks a send.
DEEPSEEK_API_KEY=


# -----------------------------------------------------------------------------
# PAYMENTS (Razorpay) — leave unset to run with payments disabled
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# -----------------------------------------------------------------------------
# TUNABLES
# -----------------------------------------------------------------------------

# How long a cart sits untouched, with no purchase, before the scheduled
# check sends a nudge. Default 30. Set to 2 for a live demo so the automated
# send is actually visible — remember to set it back afterwards.
ABANDONMENT_THRESHOLD_MINUTES=30

# Port for the local Express dev server (`pnpm dev:api`). The Vite dev
# server proxies /api here. Unused in production — Vercel invokes
# api/index.ts as a serverless function instead.
API_PORT=8787

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Allows POST /api/orders to create an order with no payment verification.
# This is the demo checkout path. Leave true until Razorpay is live; set to
# false in production once real payments work, since it lets anyone create
# order records and trigger confirmation emails.
ALLOW_UNPAID_ORDERS=true
