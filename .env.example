# Postgres connection string (e.g. from Neon, Supabase, or any Postgres host).
# Required for the API routes and for `pnpm db:push`.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Port for the local Express dev server started by `pnpm dev:api`.
# The Vite dev server proxies /api requests here. Not used in production —
# Vercel runs api/index.ts as a serverless function instead.
API_PORT=8787

# Razorpay (leave unset to run with payments disabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend — used for order confirmation + cart abandonment emails.
# Get a free key at https://resend.com. Leave unset and the app will log
# a warning and skip sending instead of crashing.
RESEND_API_KEY=
# Must be a verified sender on your Resend account, or use their shared
# onboarding@resend.dev sender for testing.
RESEND_FROM_EMAIL=LWK <onboarding@resend.dev>

# DeepSeek — used to generate a one-line human-readable insight per
# customer segment on the admin dashboard.
DEEPSEEK_API_KEY=
